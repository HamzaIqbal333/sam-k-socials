# Used only by `npm run deploy` (vite --mode ghpages). No secrets here — this just tells
# React Router the site lives at https://<your-username>.github.io/sam-k-socials/ instead of "/".
# If you name the GitHub repo something other than "sam-k-socials", update this to match exactly.
VITE_ROUTER_BASENAME=/sam-k-socials/
